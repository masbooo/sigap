Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /sigap/

    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor)(?:/|$) - [F,L]
    RewriteRule ^(?:\.env|\.git|composer\.(?:json|lock)|package\.json|phpunit\.xml|artisan|vite\.config\.js)$ - [F,L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteCond %{DOCUMENT_ROOT}/sigap/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    RewriteRule ^ index.php [QSA,L]
</IfModule>
